# Application Configuration
APP_MODE=release
SERVER_PORT=8000

# SECURITY: Generate a strong random key (min 32 chars)
# Example: openssl rand -hex 32
INTERNAL_KEY=REPLACE_WITH_SECURE_KEY

# Driver Configuration
OUTBOUND_DATABASE_DRIVER=postgres
OUTBOUND_MESSAGE_DRIVER=rabbitmq
OUTBOUND_CACHE_DRIVER=redis
OUTBOUND_WORKFLOW_DRIVER=temporal
INBOUND_HTTP_DRIVER=gin
INBOUND_MESSAGE_DRIVER=rabbitmq
INBOUND_WORKFLOW_DRIVER=temporal
AUTH_DRIVER=

# Database Configuration
DATABASE_USERNAME=go-template
DATABASE_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=go-template
# SECURITY: Enable SSL in production (require, verify-ca, or verify-full)
DATABASE_SSLMODE=disable
DATABASE_MIGRATION_DIR=./internal/migration

# Message Queue Configuration
MESSAGE_HOST=rabbitmq
MESSAGE_PORT=5672
MESSAGE_USER=go-template
MESSAGE_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
MESSAGE_VHOST=

# Cache Configuration
CACHE_HOST=redis
CACHE_PORT=6379
CACHE_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Workflow Engine Configuration
WORKFLOW_HOST=temporal
WORKFLOW_PORT=7233
WORKFLOW_NAMESPACE=default

# Auth Configuration
AUTH_JWKS_URL=http://authentik.example.com/application/o/go-template/jwks/

# Message Subscriptions
UPSERT_CLIENT_MESSAGE_SUBSCRIBE=client.upsert.subscribe

# PSQL CONTAINER TESTING
TESTCONTAINERS_RYUK_DISABLED=true

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="Your ISP"
SMTP_ENABLED=false

# Gowa WhatsApp Configuration
GOWA_API_URL=http://localhost:3000
GOWA_API_KEY=your-gowa-api-key
GOWA_ENABLED=false

# WhatsApp Group IDs (for PPPoE webhook notifications)
WHATSAPP_GROUP_NOTIFICATIONS=
WHATSAPP_GROUP_BILLING=
WHATSAPP_GROUP_SUPPORT=

# Payment Portal Configuration
PAYMENT_PORTAL_URL=https://portal.example.com
PAYMENT_PORTAL_ENABLED=true

# Xendit Payment Gateway Configuration
XENDIT_API_KEY=your-xendit-api-key
XENDIT_SECRET_KEY=your-xendit-secret-key
XENDIT_WEBHOOK_TOKEN=your-webhook-verification-token
XENDIT_ENVIRONMENT=development # development or production

# Billing & Invoice Configuration
# Note: These are defaults. Can be overridden via system_settings table
INVOICE_DUE_DAYS=7
INVOICE_GRACE_PERIOD_DAYS=3
INVOICE_LATE_FEE_ENABLED=true
INVOICE_LATE_FEE_AMOUNT=50000
INVOICE_AUTO_GENERATE_DAY=25

# Reminder Configuration
REMINDER_DAYS_BEFORE_DUE=3,1
REMINDER_DAYS_AFTER_DUE=1,3,7