# Application Configuration
APP_MODE=release
SERVER_PORT=8001

# SECURITY: Generate a strong random key (min 32 chars)
# Example: openssl rand -hex 32
INTERNAL_KEY=REPLACE_WITH_SECURE_KEY

# Driver Configuration
OUTBOUND_DATABASE_DRIVER=postgres
OUTBOUND_MESSAGE_DRIVER=rabbitmq
OUTBOUND_CACHE_DRIVER=redis
OUTBOUND_WORKFLOW_DRIVER=temporal
INBOUND_HTTP_DRIVER=gin
INBOUND_MESSAGE_DRIVER=rabbitmq
INBOUND_WORKFLOW_DRIVER=
AUTH_DRIVER=

# Database Configuration
DATABASE_USERNAME=mikrops
DATABASE_PASSWORD=changeme
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mikrops
# SECURITY: Enable SSL in production (require, verify-ca, or verify-full)
DATABASE_SSLMODE=disable
DATABASE_MIGRATION_DIR=./internal/migration

# Message Queue Configuration
MESSAGE_HOST=localhost
MESSAGE_PORT=5672
MESSAGE_USER=mikrops
MESSAGE_PASSWORD=changeme
MESSAGE_VHOST=

# Cache Configuration
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_PASSWORD=changeme

# Workflow Engine Configuration
WORKFLOW_HOST=localhost
WORKFLOW_PORT=7233
WORKFLOW_NAMESPACE=default

# Auth Configuration
AUTH_JWKS_URL=http://authentik.example.com/application/o/prabogo/jwks/

# JWT Configuration (for self-issued tokens)
JWT_SECRET=REPLACE_WITH_SECURE_KEY_MIN_32_CHARS

# Encryption Configuration (for NAS passwords)
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_KEY_EXACTLY

# File Upload Configuration
UPLOAD_PATH=./uploads

# Message Subscriptions
UPSERT_CLIENT_MESSAGE_SUBSCRIBE=client.upsert.subscribe
