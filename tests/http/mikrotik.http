### 
### 1. Login to get auth token
POST {{base_url}}/auth/login
Content-Type: application/json

{
  "email": "admin@mikrotik.local",
  "password": "Admin@123"
}

> {% 
    client.global.set("auth_token", response.body.access_token); 
%}

### 
### MikroTik Router CRUD Operations
### 

### 
### 2. Create MikroTik Router
POST {{base_url}}/mikrotik
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "name": "Router Local",
  "address": "192.168.233.1",
  "username": "admin",
  "password": "r00t",
  "api_port": 8728,
  "rest_port": 80,
  "use_ssl": false
}

### 
### 3. List All MikroTik Routers
GET {{base_url}}/mikrotik
Authorization: Bearer {{auth_token}}

### 
### 4. Get MikroTik Router by ID
GET {{base_url}}/mikrotik/{{router_id}}
Authorization: Bearer {{auth_token}}

### 
### 5. Update MikroTik Router
PUT {{base_url}}/mikrotik/{{router_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "name": "Router Local",
  "address": "192.168.233.1:8728",
  "username": "admin",
  "password": "r00t",
  "api_port": 8728,
  "rest_port": 80,
  "use_ssl": false
}

### 
### 6. Update Partial Router Fields
PUT {{base_url}}/mikrotik/{{router_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "name": "Production Router 1 - Updated Name Only"
}

### 
### 7. Update Router with Encrypted Password
PUT {{base_url}}/mikrotik/{{router_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "password": "plain_password_here",
  "password_encrypted": "encrypted_value_here"
}

### 
### 8. Delete MikroTik Router
DELETE {{base_url}}/mikrotik/{{router_id}}
Authorization: Bearer {{auth_token}}

### 
### Active Router Management
### 

### 
### 9. Set Router as Active
POST {{base_url}}/mikrotik/{{router_id}}/activate
Authorization: Bearer {{auth_token}}

### 
### 10. Get Active Router
GET {{base_url}}/mikrotik/active
Authorization: Bearer {{auth_token}}

### 
### Router Connection Testing
### 

### 
### 11. Test Router Connection
POST {{base_url}}/mikrotik/{{router_id}}/test
Authorization: Bearer {{auth_token}}

