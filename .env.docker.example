# Docker Compose Environment Variables
# Copy this file to .env.docker and update with secure values for your environment
# Usage: docker-compose --env-file .env.docker up -d

# Redis
REDIS_PASSWORD=changeme

# PostgreSQL
POSTGRES_PASSWORD=changeme
POSTGRES_USER=root
POSTGRES_DB=mikrops_db

# RabbitMQ
RABBITMQ_USER=root
RABBITMQ_PASSWORD=changeme
